<?xml version="1.0" encoding="UTF-8"?>
<!--
  ═══════════════════════════════════════════════════════════════════════════
  BLINKY — "Shadow".  The chaser.               (BTEng XML format)
  ═══════════════════════════════════════════════════════════════════════════
  Personality in one node: <SetChaseTarget/> aims at Pac-Man's own tile, every
  single decision.  No lookahead, no cleverness — just a greedy step toward
  wherever he is standing, which in a straight corridor is unbeatable.

  PRIORITY ORDER (top wins; ReactiveFallback re-checks every guard each tick)
    1  ReturnHome   eaten -> eyes take the shortest path back to the pen
    2  ExitHouse    penned or squeezing out through the door
    3  Flee         a power pellet is active -> run away from Pac-Man
    4  Scatter      scatter phase -> retreat to the top-right corner
    5  Chase        the default: walk at Pac-Man
    6  Wander       safety net; a ghost that can do nothing else keeps moving

  Every branch is <guard, pick a target, take one tile>.  StepTowardTarget
  stays RUNNING for the whole tile, so the tree's live state means something in
  ./run.sh tree, and a higher-priority guard can interrupt it mid-corridor.

  Node names are prefixed "Blinky/" because all four ghosts and Pac-Man stream
  into one ZmqPublisher on tcp://*:2667:  ./run.sh viewer  (then filter on "Blinky")
  ═══════════════════════════════════════════════════════════════════════════
-->
<BTEng format_version="1.0" main_tree_to_execute="BlinkyBrain">

  <Tree ID="BlinkyBrain">
    <ReactiveFallback name="Blinky/Brain">

      <!-- 1. Eaten: eyes only. BFS, and reversing is allowed — getting home is
              navigation, not personality. SetHouseTarget fails on arrival,
              which drops straight through to ExitHouse below. -->
      <Sequence name="Blinky/ReturnHome">
        <IsEaten name="Blinky/WasEaten"/>
        <SetHouseTarget name="Blinky/AimAtHouse"
                        target_x="{target_x}" target_y="{target_y}"/>
        <StepTowardTarget name="Blinky/StepHome"
                          target_x="{target_x}" target_y="{target_y}"
                          pathfinder="bfs" allow_reverse="true"/>
      </Sequence>

      <!-- 2. In the pen: LeaveHouse holds RUNNING through the release timer and
              the walk out, then hands the ghost back to the world. -->
      <Sequence name="Blinky/ExitHouse">
        <IsInHouse name="Blinky/Penned"/>
        <LeaveHouse name="Blinky/WalkOut"/>
      </Sequence>

      <!-- 3. Frightened: aim at a point directly away from Pac-Man and step
              greedily toward it. Swap in <WanderStep/> for the arcade's
              random turns. -->
      <Sequence name="Blinky/Flee">
        <IsFrightened name="Blinky/Scared"/>
        <SetFleeTarget name="Blinky/AimAway" lookahead="10"
                       target_x="{target_x}" target_y="{target_y}"/>
        <StepTowardTarget name="Blinky/StepAway"
                          target_x="{target_x}" target_y="{target_y}"
                          pathfinder="greedy"/>
      </Sequence>

      <!-- 4. Scatter: top-right corner. corner_x/corner_y override the corner
              the world assigned; drop them to use the assigned one. -->
      <Sequence name="Blinky/Scatter">
        <IsScatterMode name="Blinky/ScatterPhase"/>
        <SetScatterTarget name="Blinky/AimAtCorner" corner_x="26" corner_y="1"
                          target_x="{target_x}" target_y="{target_y}"/>
        <StepTowardTarget name="Blinky/StepToCorner"
                          target_x="{target_x}" target_y="{target_y}"/>
      </Sequence>

      <!-- 5. Chase: the one node that makes this ghost Blinky. -->
      <Sequence name="Blinky/Chase">
        <SetChaseTarget name="Blinky/AimAtPacman"
                        target_x="{target_x}" target_y="{target_y}"/>
        <StepTowardTarget name="Blinky/StepToPacman"
                          target_x="{target_x}" target_y="{target_y}"/>
      </Sequence>

      <!-- 6. Nothing above worked (walled in by a reversal ban, say). -->
      <WanderStep name="Blinky/Wander"/>

    </ReactiveFallback>
  </Tree>

  <TreeNodesModel>
    <Condition ID="IsEaten"/>

    <Condition ID="IsInHouse"/>

    <Condition ID="IsFrightened"/>

    <Condition ID="IsScatterMode"/>

    <Condition ID="IsPacmanWithin">
      <input_port name="distance"/>
      <input_port name="metric"/>
    </Condition>

    <Action ID="SetHouseTarget">
      <output_port name="target_x"/>
      <output_port name="target_y"/>
    </Action>

    <Action ID="SetFleeTarget">
      <output_port name="target_x"/>
      <output_port name="target_y"/>
      <input_port name="lookahead"/>
    </Action>

    <Action ID="SetScatterTarget">
      <output_port name="target_x"/>
      <output_port name="target_y"/>
      <input_port name="corner_x"/>
      <input_port name="corner_y"/>
    </Action>

    <Action ID="SetChaseTarget">
      <output_port name="target_x"/>
      <output_port name="target_y"/>
    </Action>

    <Action ID="SetAmbushTarget">
      <output_port name="target_x"/>
      <output_port name="target_y"/>
      <input_port name="lead_tiles"/>
    </Action>

    <Action ID="SetFlankTarget">
      <output_port name="target_x"/>
      <output_port name="target_y"/>
      <input_port name="partner"/>
      <input_port name="lead_tiles"/>
    </Action>

    <Action ID="SetShyTarget">
      <output_port name="target_x"/>
      <output_port name="target_y"/>
      <input_port name="flee_radius"/>
      <input_port name="corner_x"/>
      <input_port name="corner_y"/>
    </Action>

    <Action ID="LeaveHouse"/>

    <Action ID="StepTowardTarget">
      <input_port name="allow_reverse"/>
      <input_port name="target_x"/>
      <input_port name="target_y"/>
      <input_port name="pathfinder"/>
    </Action>

    <Action ID="WanderStep">
      <input_port name="allow_reverse"/>
    </Action>
  </TreeNodesModel>

</BTEng>
